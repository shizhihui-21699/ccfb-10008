# Copy to .env and adjust. All variables are optional in development
# (ephemeral random keys are generated), but MUST be set explicitly in
# production so restarts don't invalidate sessions and stored secrets.

# SQLite database file location.
MFA_DB_PATH=instance/mfa.sqlite3

# Flask session cookie signing key (any long random string).
MFA_SECRET_KEY=change-me-to-a-long-random-value

# Fernet key (AES) used to encrypt TOTP shared secrets at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_TOTP_KEY=

# HMAC pepper for backup-code hashes (any long random hex string).
MFA_BACKUP_PEPPER=
